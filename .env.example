# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Supabase project credentials ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# --- Prisma / Postgres connection strings ---
# Use Supavisor transaction mode (6543) for serverless runtimes like Vercel.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Use a direct or non-transaction connection for migrations and Prisma CLI.
DIRECT_URL="postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres"
