# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Railway PostgreSQL / Prisma ---
# Local example:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/thebonnet"

# --- Private admin access ---
# These stay server-side only and should never be exposed to the public frontend.
ADMIN_EMAIL="superadmin@thebonnet.co.za"
ADMIN_PASSWORD="change-this-before-deploy"
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"

# --- AI Diagnosis ---
ANTHROPIC_API_KEY="sk-ant-..."  # Required for AI diagnosis feature

AUTH_SECRET="generate-with-openssl-rand-base64-32"
EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
EMAIL_FROM="noreply@thebonnet.co.za"
NEXTAUTH_URL="https://thebonnet.co.za"

# --- Twilio WhatsApp ---
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# --- Paystack ---
PAYSTACK_SECRET_KEY="sk_live_xxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_live_xxxxxxxx"

NEXT_PUBLIC_SENTRY_DSN="https://xxx@sentry.io/xxx"
SENTRY_AUTH_TOKEN="sntrys_xxx"

CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-api-secret"

NEXT_PUBLIC_POSTHOG_KEY="phc_xxx"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
POSTHOG_KEY="phc_xxx"

# --- Railway service variable references ---
# Add this in your Railway web service Variables tab:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# NEXT_PUBLIC_SITE_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
# ADMIN_EMAIL=superadmin@thebonnet.co.za
# ADMIN_PASSWORD=your-private-password
# ADMIN_SESSION_SECRET=your-long-random-secret
CRON_SECRET="a-random-secret-for-cron-auth"

# --- Google Places API ---
GOOGLE_PLACES_API_KEY="your-google-places-api-key"
